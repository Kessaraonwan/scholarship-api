# ─── ไฟล์นี้คือตัวอย่าง — copy เป็น .env แล้วใส่ค่าจริง ───────
# ห้าม commit .env ขึ้น GitHub เด็ดขาด

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ingestion_db"

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
AUTH_SERVICE_URL=http://localhost:3001

# ─── Internal Service Communication ─────────────────────────────
# ใช้ header X-Internal-Secret เมื่อ service เรียกหากันข้างใน
INTERNAL_SECRET=internal-secret-key

# ─── Service URLs (สำหรับ service ที่ต้องเรียก service อื่น) ───
INGESTION_SERVICE_URL=http://localhost:3002
CORE_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
LANDING_SERVICE_URL=http://localhost:3000

# ─── Email (service-notification เท่านั้น) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000


