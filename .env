# ─── ไฟล์นี้คือตัวอย่าง — copy เป็น .env แล้วใส่ค่าจริง ───────
# ห้าม commit .env ขึ้น GitHub เด็ดขาด

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarship_db

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-for-scholarship-api-2024-secure-random-string
ADMIN_SECRET_KEY=admin-secret-key-for-scholarship-api-2024-secure-random-string
AUTH_SERVICE_URL=http://localhost:3001

# ─── Internal Service Communication ─────────────────────────────
# ใช้ header X-Internal-Secret เมื่อ service เรียกหากันข้างใน
INTERNAL_SECRET=internal-secret-key

# ─── Service URLs (สำหรับ service ที่ต้องเรียก service อื่น) ───
INGESTION_SERVICE_URL=http://localhost:3002
CORE_SERVICE_URL=http://localhost:3003