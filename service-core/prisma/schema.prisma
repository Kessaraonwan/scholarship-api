generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scholarship {
  id          String    @id @default(cuid())
  name        String
  level       String
  field       String
  country     String
  deadline    DateTime?
  amount      Int?
  currency    String    @default("USD")
  url         String    @unique
  source      String
  description String?
  lastUpdated DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([name, source])
  @@index([source])
  @@index([deadline])
  @@index([field])
}
