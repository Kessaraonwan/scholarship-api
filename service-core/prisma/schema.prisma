generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scholarship {
  id          String    @id @default(cuid())
  name        String
  level       String
  field       String
  country     String
  deadline    DateTime?
  amount      Int?
  currency    String    @default("USD")
  url         String    @unique
  source      String
  description String?
  lastUpdated DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([name, source])
  @@index([source])
  @@index([deadline])
  @@index([field])
}

model ingestion_logs {
  id           String    @id @default(dbgenerated("nextval('ingestion_logs_id_seq'::regclass)"))
  source       String
  status       String    @default("running")
  countNew     Int       @default(0)
  countUpdated Int       @default(0)
  errorMsg     String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source])
  @@index([startedAt])
}
